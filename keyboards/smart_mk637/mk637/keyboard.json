{
    "keyboard_name": "AL68 Keyboard",
    "usb": {
        "pid": "0x304E",
        "device_version": "1.1.7",
        "wait_for_enumeration": false,
        "no_startup_check": true                                     
    },
    "diode_direction": "ROW2COL",

    "matrix_pins": {
        "rows": ["A0", "A1", "A2", "A3", "A4"],
        "cols": ["B0","B2", "B10", "B11", "B12", "B13", "B14", "B15", "A14", "B3", "A15", "B5","B6", "B7", "C13"]   
    },
    "host": {
        "default": {
            "nkro" : true
        }
    },


    "features": {
        "bootmagic": true,
        "command": true,
        "console": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true,
        "rgb_matrix":true,
        "os_detection":true,
        "encoder": true
    },

    "rgblight": {
        "led_count": 2,
        "driver": "custom",
        "animations": {
            "rainbow_mood" : true
        }
    },

    "encoder": {
        "rotary": [
            { "pin_a": "A6", "pin_b": "A7" }
        ]
    },




    "ws2812": {
        "pin": "B8",
        "driver": "pwm"
      },
